# Optional ElevenLabs voice. Without this, the dashboard uses browser speech APIs.
# Create a key at https://elevenlabs.io/ and keep this file private.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_turbo_v2_5

# Gemini chat and low-latency native voice models.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
JARVIS_VOICE_MODE=auto
JARVIS_STT_MODEL=base
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Aoede

# Hermes profile whose tools, skills, memory, browser, and MCP servers are inherited.
HERMES_PROFILE=default

# Optional absolute command if `hermes` is not on PATH.
# HERMES_CMD=/absolute/path/to/hermes

# Agent working directory and local dashboard port.
JARVIS_WORKDIR=~
JARVIS_PERMISSION=normal
JARVIS_TIMEOUT=120
JARVIS_PORT=8730
JARVIS_OPEN=1

# Local Hermes API: run `python setup_hermes_api.py` to populate these privately.
HERMES_API_BASE=http://127.0.0.1:8642
HERMES_API_KEY=

# Owner access on a reserved ngrok hostname. Set this to your exact HTTPS origin.
JARVIS_PUBLIC_ORIGIN=

# Optional Vapi/Twilio phone line. Configure a separate tool-restricted Hermes
# phone profile before enabling AI calls. Never put real keys in this example.
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_LLM_TOKEN=
HERMES_PHONE_API_BASE=
HERMES_PHONE_API_KEY=
